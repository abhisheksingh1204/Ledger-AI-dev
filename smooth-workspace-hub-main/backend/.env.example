PORT=5000
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/Finance

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_INTERNAL_TOKEN=change_me
OCR_SERVICE_TIMEOUT_MS=120000

# Optional local development fallback fields if DATABASE_URL is not used.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Finance
DB_USER=postgres
DB_PASSWORD=postgres

# Groq is server-side only. Never expose this key to the frontend.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000

# Gemini is server-side only and is used only when OCR.Space fails for an eligible provider reason.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_OCR_TIMEOUT_MS=120000
