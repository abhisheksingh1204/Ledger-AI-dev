PORT=5000
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/Finance

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_INTERNAL_TOKEN=change_me
OCR_SERVICE_TIMEOUT_MS=120000
ALLOW_INSECURE_INTERNAL_SERVICE=false
MAX_DOCUMENT_SIZE_MB=10
OCR_SPACE_MAX_FILE_SIZE_MB=1

# Optional local development fallback fields if DATABASE_URL is not used.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Finance
DB_USER=postgres
DB_PASSWORD=postgres

# Groq is server-side only. Never expose this key to the frontend.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000

# Gemini is server-side only and is used only when OCR.Space fails for an eligible provider reason.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_OCR_TIMEOUT_MS=120000

SEMANTIC_SERVICE_URL=http://127.0.0.1:8001
SEMANTIC_TIMEOUT_MS=120000
E5_MODEL_NAME=intfloat/e5-small-v2

RECON_AMOUNT_TOLERANCE=0.01
RECON_DATE_BEFORE_DAYS=7
RECON_DATE_AFTER_DAYS=30
RECON_AUTO_MATCH_THRESHOLD=90
RECON_REVIEW_THRESHOLD=70
RECON_WEIGHT_AMOUNT=35
RECON_WEIGHT_REFERENCE=25
RECON_WEIGHT_NAME=15
RECON_WEIGHT_SEMANTIC=15
RECON_WEIGHT_DATE=10

DB_POOL_MIN=2
DB_POOL_MAX=10
EMBEDDING_MODEL=local-hash-embedding-v1
EMBEDDING_DIMENSION=96
